<Window x:Class="ResearchHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ResearchHub.Services" 
        Title="ResearchHub - Panel Główny" Height="750" Width="1050"
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource WindowBackgroundBrush}" 
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:StatusToBgConverter x:Key="StatusToBgConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="15" Padding="12" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="● SQL SERVER CONNECTED" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="10"/>
                    <TextBlock Text="{Binding UserRole, StringFormat='Rola: {0}'}" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="10,20,10,10">
                <TextBlock Text="NAWIGACJA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="15,0,0,10"/>
                <Button Content="Repozytorium" Height="35" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Margin="5,0,5,5" HorizontalContentAlignment="Left" Padding="15,0,0,0"/>
            </StackPanel>

            <StackPanel Margin="10,20,10,20" Grid.Row="1" VerticalAlignment="Bottom">
                <TextBlock Text="Wybierz motyw:" 
               Foreground="{DynamicResource TextSecondaryBrush}" 
               HorizontalAlignment="Center" 
               FontSize="12" 
               Margin="0,0,0,10"/>

                <UniformGrid Columns="3" Rows="2">
                    <Button Content="Light" ToolTip="Jasny" Command="{Binding ChangeThemeCommand}" CommandParameter="Light" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Margin="4" Cursor="Hand"/>
                    <Button Content="Dark" ToolTip="Ciemny" Command="{Binding ChangeThemeCommand}" CommandParameter="Dark" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Margin="4" Cursor="Hand"/>
                    <Button Content="🌸" ToolTip="Różowy" Command="{Binding ChangeThemeCommand}" CommandParameter="Pink" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Margin="4" Cursor="Hand"/>
                    <Button Content="Blue" ToolTip="Niebieski" Command="{Binding ChangeThemeCommand}" CommandParameter="Blue" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Margin="4" Cursor="Hand"/>
                    <Button Content="Green" ToolTip="Zielony" Command="{Binding ChangeThemeCommand}" CommandParameter="Green" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Margin="4" Cursor="Hand"/>
                    <Button Content="Yellow" ToolTip="Żółty" Command="{Binding ChangeThemeCommand}" CommandParameter="Yellow" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Margin="4" Cursor="Hand"/>
                </UniformGrid>
            </StackPanel>

            <Button Grid.Row="2" Command="{Binding LogoutCommand}" Content="Wyloguj" Height="35" Margin="15" Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerBrush}" BorderThickness="0"/>
        </Grid>

        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ResearchHub - Panel Badawczy" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="15,8"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryAccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="Publikacje">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,15,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="38" Margin="0,0,15,0" 
                                     Background="{DynamicResource InputBackgroundBrush}" 
                                     Foreground="{DynamicResource TextPrimaryBrush}" 
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                     VerticalContentAlignment="Center" Padding="12,0,0,0">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedTypeFilter, Mode=TwoWay}" SelectedValuePath="Content" 
                                      Height="38" Background="{DynamicResource InputBackgroundBrush}" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" 
                                      BorderBrush="{DynamicResource BorderBrush}" 
                                      VerticalContentAlignment="Center" Margin="0,0,15,0">
                                <ComboBoxItem IsSelected="True">Wszystkie typy</ComboBoxItem>
                                <ComboBoxItem Content="Artykul"/>
                                <ComboBoxItem Content="Ksiazka"/>
                                <ComboBoxItem Content="Raport"/>
                                <ComboBoxItem Content="Monografia"/>
                                <ComboBoxItem Content="Biblioografia"/>
                                <ComboBoxItem Content="Inne"/>
                            </ComboBox>

                            <Button Grid.Column="2" Content="+ Dodaj publikację" 
                                    Command="{Binding OpenAddWindowCommand}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"
                                    Height="38" Padding="20,0" 
                                    Background="{DynamicResource SuccessBrush}" 
                                    Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PublicationsView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,15,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="140" Height="180" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Tytul}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>

                                                        <Button Grid.Column="1" Command="{Binding DataContext.FavoritePublicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding ID}"
                                                                BorderThickness="1" Padding="12,6" Cursor="Hand" VerticalAlignment="Top" Margin="10,0,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Content" Value="☆ Dodaj do ulubionych"/>
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource FavoriteBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CzyUlubione}" Value="True">
                                                                            <Setter Property="Content" Value="★ W ulubionych"/>
                                                                            <Setter Property="Background" Value="{DynamicResource FavoriteBrush}"/>
                                                                            <Setter Property="Foreground" Value="#1E1E20"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource FavoriteBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Wydawnictwo, StringFormat='Wydawnictwo: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,6,0,12"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding RokWydania, StringFormat='Rok: {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                            <TextBlock Text="{Binding Typ}" Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding PlikPdf, StringFormat='📄 {0}'}" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,4" Cursor="Hand" FontSize="13"/>
                                                    <TextBlock Text="{Binding Strony, StringFormat='Ilość stron: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,15" FontSize="12"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="✎ Edytuj" 
                                                                Command="{Binding DataContext.EditPublicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Background="{DynamicResource SidebarBackgroundBrush}" 
                                                                Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                BorderThickness="0" Padding="15,6" Margin="0,0,10,0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="🗑 Usuń" 
                                                                Command="{Binding DataContext.DeletePublicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding ID}"
                                                                Visibility="{Binding DataContext.IsAdmin, Converter={StaticResource BoolToVisConverter}, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Background="{DynamicResource DangerBackgroundBrush}" 
                                                                Foreground="{DynamicResource DangerBrush}" 
                                                                BorderThickness="0" Padding="15,6" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ZAKŁADKA 2: PROJEKTY -->
                <TabItem Header="Projekty Badawcze">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Aktywne i zakończone projekty badawcze" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,15" Grid.ColumnSpan="2"/>

                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="38" Margin="0,0,15,0" 
                                 Background="{DynamicResource InputBackgroundBrush}" 
                                 Foreground="{DynamicResource TextPrimaryBrush}" 
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                 VerticalContentAlignment="Center" Padding="12,0,0,0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ProjectsView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,15,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="140" Height="140" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                            <TextBlock Text="{Binding Tytul}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                            <Border Background="{Binding CzyRekrutacjaOtwarta, Converter={StaticResource StatusToBgConverter}}" 
            CornerRadius="4" Padding="6,2" Margin="10,0,0,0" 
            VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusTekst}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <Button Grid.Column="1" Command="{Binding DataContext.FavoriteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding ID}"
                                                                BorderThickness="1" Padding="12,6" Cursor="Hand" VerticalAlignment="Top" Margin="10,0,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Content" Value="☆ Dodaj do ulubionych"/>
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource FavoriteBrush}"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CzyUlubione}" Value="True">
                                                                            <Setter Property="Content" Value="★ W ulubionych"/>
                                                                            <Setter Property="Background" Value="{DynamicResource FavoriteBrush}"/>
                                                                            <Setter Property="Foreground" Value="#1E1E20"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource FavoriteBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Opis}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,8,0,15" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="📅" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DataRozpoczecia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource SuccessBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" ➔ " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBlock Text="{Binding DataZakonczenia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource DangerBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal">

                                                        <Button Content="✎ Edytuj" 
                                                                Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Visibility="{Binding DataContext.IsAdmin, Converter={StaticResource BoolToVisConverter}, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Background="{DynamicResource SidebarBackgroundBrush}" 
                                                                Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                BorderThickness="0" Padding="15,6" Margin="0,0,10,0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Command="{Binding DataContext.JoinProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding ID}"
        Visibility="{Binding DataContext.IsStudent, Converter={StaticResource BoolToVisConverter}, RelativeSource={RelativeSource AncestorType=Window}}"
        BorderThickness="0" Padding="15,6" Margin="0,0,10,0" Cursor="Hand">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Content" Value="➕ Dołącz do projektu"/>
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="IsEnabled" Value="True"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CzyRekrutacjaOtwarta}" Value="False">
                                                                            <Setter Property="Content" Value="🔒 Rekrutacja zamknięta"/>
                                                                            <Setter Property="Background" Value="#A0A0A0"/>
                                                                            <Setter Property="Foreground" Value="#EEEEEE"/>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding CzyDolaczono}" Value="True">
                                                                            <Setter Property="Content" Value="✔️ Dołączono"/>
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>

                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="🗑 Usuń" 
                                                                Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding ID}"
                                                                Visibility="{Binding DataContext.IsAdmin, Converter={StaticResource BoolToVisConverter}, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Background="{DynamicResource DangerBackgroundBrush}" 
                                                                Foreground="{DynamicResource DangerBrush}" 
                                                                BorderThickness="0" Padding="15,6" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ZAKŁADKA 3: KONFERENCJE -->
                <TabItem Header="Konferencje">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Content="➕ Dodaj konferencję" 
                        Command="{Binding CreateConferenceCommand}"
                        Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVisConverter}}"
                        Background="{DynamicResource PrimaryAccentBrush}" 
                        Foreground="White" FontWeight="SemiBold" Padding="15,8" 
                        HorizontalAlignment="Right" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBlock Grid.Row="0" Text="Harmonogram nadchodzących konferencji naukowych" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,15"/>

                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="38" Margin="0,0,174,0" 
                                 Background="{DynamicResource InputBackgroundBrush}" 
                                 Foreground="{DynamicResource TextPrimaryBrush}" 
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                 VerticalContentAlignment="Center" Padding="12,0,0,0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding ConferencesView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,15,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="160" Height="120" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Nazwa}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>

                                                        <Button Grid.Column="1" Command="{Binding DataContext.FavoriteConferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding ID}"
                                                                BorderThickness="1" Padding="12,6" Cursor="Hand" VerticalAlignment="Top" Margin="10,0,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Content" Value="☆ Dodaj do ulubionych"/>
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource FavoriteBrush}"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CzyUlubione}" Value="True">
                                                                            <Setter Property="Content" Value="★ W ulubionych"/>
                                                                            <Setter Property="Background" Value="{DynamicResource FavoriteBrush}"/>
                                                                            <Setter Property="Foreground" Value="#1E1E20"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource FavoriteBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">

                                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📅 " Foreground="{DynamicResource SuccessBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Data, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📍 " Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Miejsce}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal">

                                                        <Button Content="✎ Edytuj" 
                                                                Command="{Binding DataContext.EditConferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                Visibility="{Binding DataContext.AdminVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Background="{DynamicResource SidebarBackgroundBrush}" 
                                                                Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                BorderThickness="0" Padding="15,6" Margin="0,0,10,0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="🗑 Usuń" 
                                                                Command="{Binding DataContext.DeleteConferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding ID}"
                                                                Visibility="{Binding DataContext.IsAdmin, Converter={StaticResource BoolToVisConverter}, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Background="{DynamicResource DangerBackgroundBrush}" 
                                                                Foreground="{DynamicResource DangerBrush}" 
                                                                BorderThickness="0" Padding="15,6" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    
                </TabItem>
                <!--ULUBIONE-->
                <TabItem Header="Ulubione">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Margin="0,15,0,0">
                        <StackPanel Margin="0,0,15,20">

                            <TextBlock Text="Moje zapisane materiały" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,25"/>

                            <TextBlock Text="Ulubione Publikacje" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding FavoritePublications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="120" Height="140" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Tytul}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Wydawnictwo, StringFormat='Wydawnictwo: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,6,0,12"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding RokWydania, StringFormat='Rok: {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                            <TextBlock Text="{Binding Typ}" Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding PlikPdf, StringFormat='📄 {0}'}" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,15" Cursor="Hand" FontSize="13"/>

                                                    <Button Content="💔 Usuń z ulubionych" 
                                                            Command="{Binding DataContext.FavoritePublicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding ID}" 
                                                            HorizontalAlignment="Left" Padding="12,6" Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Ulubione Projekty" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,20,0,10"/>
                            <ItemsControl ItemsSource="{Binding FavoriteProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="140" Height="140" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Tytul}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Opis}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,8,0,12" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="📅" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DataRozpoczecia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource SuccessBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" ➔ " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBlock Text="{Binding DataZakonczenia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource DangerBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Button Content="💔 Usuń z ulubionych" 
                                                            Command="{Binding DataContext.FavoriteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding ID}" 
                                                            HorizontalAlignment="Left" Padding="12,6" Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Ulubione Konferencje" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,20,0,10"/>
                            <ItemsControl ItemsSource="{Binding FavoriteConferences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="160" Height="120" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nazwa}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📅 " Foreground="{DynamicResource SuccessBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Data, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📍 " Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Miejsce}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <Button Content="💔 Usuń z ulubionych" 
                                                            Command="{Binding DataContext.FavoriteConferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding ID}" 
                                                            HorizontalAlignment="Left" Padding="12,6" Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- ZAKŁADKA 5: MOJE PROJEKTY -->

                <TabItem Header="Moje projekty" Visibility="{Binding IsStudent, Converter={StaticResource BoolToVisConverter}}">
                    <Grid Margin="0,15,0,0">
                        <TextBlock Text="Projekty, do których należysz" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" VerticalAlignment="Top"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,40,0,0">
                            <ItemsControl ItemsSource="{Binding MyProjectsList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,15,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="100" Height="100" CornerRadius="8" Margin="0,0,20,0">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Tytul}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <TextBlock Text="📅" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DataRozpoczecia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource SuccessBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" ➔ " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBlock Text="{Binding DataZakonczenia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource DangerBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">

                                                    <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,0,8">
                                                        <TextBlock Text="✔️ Uczestnik" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                                    </Border>

                                                    <Button Content="❌ Zrezygnuj" 
                                                Command="{Binding DataContext.LeaveProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding ID}" 
                                                Background="{DynamicResource DangerBackgroundBrush}" 
                                                Foreground="{DynamicResource TextPrimaryBrush}" 
                                                FontWeight="SemiBold" 
                                                BorderThickness="0" Padding="12,6" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>

                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <!--DLA PRACOWNIKA>-->
                <TabItem Header="Zarządzanie projektami" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVisConverter}}">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,15,20">
                            <TextBlock Text="Panel menedżera projektów" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Content="➕ Utwórz nowy projekt" 
                    Command="{Binding CreateProjectCommand}"
                    Background="{DynamicResource PrimaryAccentBrush}" 
                    Foreground="White" 
                    FontWeight="SemiBold" 
                    Padding="15,8" 
                    HorizontalAlignment="Right" 
                    Cursor="Hand"
                    BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ManagedProjectsList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,15,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="110" Height="110" CornerRadius="8" Margin="0,0,20,0">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding Tytul}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>

                                                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{Binding CzyRekrutacjaOtwarta, Converter={StaticResource StatusToBgConverter}}">
                                                            <TextBlock Text="{Binding StatusTekst}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Opis}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" MaxHeight="40" TextTrimming="WordEllipsis" Margin="0,0,0,8"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📅" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DataRozpoczecia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                        <TextBlock Text=" ➔ " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                                        <TextBlock Text="{Binding DataZakonczenia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="140" Margin="10,0,0,0">

                                                    <Button Content="✏️ Edytuj" 
                                            Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6" Padding="5" Cursor="Hand"/>

                                                    <Button Content="{Binding PrzyciskRekrutacjiTekst}" 
                                            Command="{Binding DataContext.ToggleRecruitmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryAccentBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6" Padding="5" Cursor="Hand"/>

                                                    <Button Content="🗑️ Usuń" 
                                            Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ID}"
                                            Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerBrush}" 
                                            BorderThickness="0" Padding="5" Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>