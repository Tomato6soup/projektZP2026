<Window x:Class="ResearchHub.View.EditConferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edytuj Konferencję" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nazwa konferencji:" Foreground="White" Margin="0,5"/>
        <TextBox x:Name="txtNazwa" Grid.Row="1" Margin="0,0,0,15" Padding="5"/>

        <TextBlock Text="Data:" Grid.Row="2" Foreground="White" Margin="0,5"/>
        <DatePicker x:Name="dpData" Grid.Row="3" Margin="0,0,0,15"/>

        <TextBlock Text="Miejsce:" Grid.Row="4" Foreground="White" Margin="0,5"/>
        <TextBox x:Name="txtMiejsce" Grid.Row="5" Margin="0,0,0,15" Padding="5"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Anuluj" Width="80" Padding="5" Margin="0,0,10,0" Click="btnAnuluj_Click"/>
            <Button Content="Zapisz" Width="80" Padding="5" Background="#0078D7" Foreground="White" Click="btnZapisz_Click"/>
        </StackPanel>
    </Grid>
</Window>