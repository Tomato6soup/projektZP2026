<Window x:Class="ResearchHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResearchHub - Panel Główny" Height="750" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#18181A" Foreground="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL BOCZNY (Sidebar) -->
        <Grid Grid.Column="0" Background="#1E1E20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status SQL (Poprawiony: Border zamiast StackPanel rozwiązuje błąd z Padding) -->
            <Border Grid.Row="0" Margin="15" Padding="12" Background="#29292C" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="● SQL SERVER CONNECTED" Foreground="#107C41" FontWeight="Bold" FontSize="10"/>
                    <TextBlock Text="{Binding UserRole, StringFormat='Rola: {0}'}" FontSize="12" Margin="0,5,0,0" Foreground="White"/>
                </StackPanel>
            </Border>

            <!-- Menu Nawigacji informacyjne -->
            <StackPanel Grid.Row="1" Margin="10,20,10,10">
                <TextBlock Text="NAWIGACJA" Foreground="#7F7F82" FontSize="11" FontWeight="Bold" Margin="15,0,0,10"/>
                <Button Content="Repozytorium" Height="35" Background="#2D2D30" Foreground="White" BorderThickness="0" Margin="5,0,5,5" HorizontalContentAlignment="Left" Padding="15,0,0,0"/>
            </StackPanel>


            <!-- Stopka panelu -->
            <Button Grid.Row="2" Command="{Binding LogoutCommand}" Content="Wyloguj" Height="35" Margin="15" Background="#C42B1C" Foreground="White" BorderThickness="0"/>
        </Grid>

        <!-- OBSZAR ROBOCZY (Workspace) -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Nagłówek główny systemu -->
            <TextBlock Grid.Row="0" Text="ResearchHub - Panel Badawczy" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>

            <!-- Nowoczesny TabControl (Rozwiązuje błąd nakładania się kontrolek i ułatwia przeglądanie) -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <!-- Stylizacja zakładek, aby pasowały do ciemnego motywu -->
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#1E1E20"/>
                        <Setter Property="Foreground" Value="#A0A0A5"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="15,8"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!-- ZAKŁADKA 1: PUBLIKACJE -->
                <TabItem Header="Publikacje">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,15,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Height="38" Margin="0,0,15,0" 
                     Background="#1E1E20" Foreground="#EEEEEE" BorderBrush="#333337" BorderThickness="1" 
                     VerticalContentAlignment="Center" Padding="12,0,0,0">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedTypeFilter, Mode=TwoWay}" SelectedValuePath="Content" 
                      Height="38" Background="#1E1E20" Foreground="Black" BorderBrush="#333337" 
                      VerticalContentAlignment="Center" Margin="0,0,15,0">
                                <ComboBoxItem IsSelected="True">Wszystkie typy</ComboBoxItem>
                                <ComboBoxItem Content="Artykul"/>
                                <ComboBoxItem Content="Ksiazka"/>
                                <ComboBoxItem Content="Raport"/>
                                <ComboBoxItem Content="Monografia"/>
                                <ComboBoxItem Content="Biblioografia"/>
                                <ComboBoxItem Content="Inne"/>
                            </ComboBox>

                            <Button Grid.Column="2" Content="+ Dodaj publikację" 
                    Command="{Binding OpenAddWindowCommand}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"
                    Height="38" Padding="20,0" 
                    Background="#2E7D32" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PublicationsView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E20" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Margin="0,0,15,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="140" Height="180" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1">

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Tytul}" FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Command="{Binding DataContext.FavoritePublicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding ID}"
        BorderThickness="1" Padding="12,6" Cursor="Hand" VerticalAlignment="Top" Margin="10,0,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Content" Value="☆ Dodaj do ulubionych"/>
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Foreground" Value="#E2C044"/>
                                                                    <Setter Property="BorderBrush" Value="#E2C044"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CzyUlubione}" Value="True">
                                                                            <Setter Property="Content" Value="★ W ulubionych"/>
                                                                            <Setter Property="Background" Value="#E2C044"/>
                                                                            <Setter Property="Foreground" Value="#1E1E20"/>
                                                                            <Setter Property="BorderBrush" Value="#E2C044"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Wydawnictwo, StringFormat='Wydawnictwo: {0}'}" Foreground="#9E9E9E" FontSize="14" Margin="0,6,0,12"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding RokWydania, StringFormat='Rok: {0}'}" Foreground="#DDDDDD" FontSize="12"/>
                                                        </Border>
                                                        <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                            <TextBlock Text="{Binding Typ}" Foreground="#64B5F6" FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding PlikPdf, StringFormat='📄 {0}'}" Foreground="#64B5F6" Margin="0,0,0,4" Cursor="Hand" FontSize="13"/>
                                                    <TextBlock Text="{Binding Strony, StringFormat='Ilość stron: {0}'}" Foreground="#777777" Margin="0,0,0,15" FontSize="12"/>

                                                    <StackPanel Orientation="Horizontal">

                                                        <Button Content="✎ Edytuj" 
                                                Command="{Binding DataContext.EditPublicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" 
                                                Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#2D2D30" Foreground="#DDDDDD" BorderThickness="0" Padding="15,6" Margin="0,0,10,0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="🗑 Usuń" 
                                                Command="{Binding DataContext.DeletePublicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding ID}"
                                                Visibility="{Binding DataContext.IsAdmin, Converter={StaticResource BoolToVisConverter}, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#3A2020" Foreground="#FF6B6B" BorderThickness="0" Padding="15,6" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ZAKŁADKA 2: PROJEKTY -->
                <TabItem Header="Projekty Badawcze">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Aktywne i zakończone projekty badawcze" FontSize="16" Foreground="#88888D" Margin="0,0,0,15" Grid.ColumnSpan="2"/>
                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
Height="38" Margin="0,0,15,0" 
Background="#1E1E20" Foreground="#EEEEEE" BorderBrush="#333337" BorderThickness="1" 
VerticalContentAlignment="Center" Padding="12,0,0,0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ProjectsView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E20" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Margin="0,0,15,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="140" Height="140" CornerRadius="8" Margin="0,0,20,0"  VerticalAlignment="Top">
                                                    <Border.Background>
                                                      <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column ="0" Text="{Binding Tytul}" FontSize="22" FontWeight="SemiBold" Foreground="#EEEEEE" TextWrapping="Wrap" VerticalAlignment="Center"/>

                                                        <Button Grid.Column="1" Command="{Binding DataContext.FavoriteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding ID}"
        BorderThickness="1" Padding="12,6" Cursor="Hand" VerticalAlignment="Top" Margin="10,0,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Content" Value="☆ Dodaj do ulubionych"/>
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Foreground" Value="#E2C044"/>
                                                                    <Setter Property="BorderBrush" Value="#E2C044"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CzyUlubione}" Value="True">
                                                                            <Setter Property="Content" Value="★ W ulubionych"/>
                                                                            <Setter Property="Background" Value="#E2C044"/>
                                                                            <Setter Property="Foreground" Value="#1E1E20"/>
                                                                            <Setter Property="BorderBrush" Value="#E2C044"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Opis}" Foreground="#9E9E9E" FontSize="14" Margin="0,8,0,15" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="📅" FontSize="12" Foreground="#666" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DataRozpoczecia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#81C784" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" ➔ " Foreground="#555" FontSize="13" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBlock Text="{Binding DataZakonczenia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#E57373" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal">

                                                        <Button Content="✎ Edytuj" 
                                                Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" 
                                                Visibility="{Binding DataContext.AdminVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#2D2D30" Foreground="#DDDDDD" BorderThickness="0" Padding="15,6" Margin="0,0,10,0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.JoinProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding ID}"
        Visibility="{Binding DataContext.IsStudent, Converter={StaticResource BoolToVisConverter}, RelativeSource={RelativeSource AncestorType=Window}}"
        BorderThickness="0" Padding="15,6" Margin="0,0,10,0" Cursor="Hand">

                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Content" Value="➕ Dołącz do projektu"/>
                                                                    <Setter Property="Background" Value="HotPink"/>
                                                                    <Setter Property="Foreground" Value="#E0F2F1"/>
                                                                    <Setter Property="IsEnabled" Value="True"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CzyDolaczono}" Value="True">
                                                                            <Setter Property="Content" Value="✔️ Dołączono"/>
                                                                            <Setter Property="Background" Value="Green"/>
                                                                            <Setter Property="Foreground" Value="Green"/>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>

                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="🗑 Usuń" 
                                                Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding ID}"
                                                Visibility="{Binding DataContext.IsAdmin, Converter={StaticResource BoolToVisConverter}, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#3A2020" Foreground="#FF6B6B" BorderThickness="0" Padding="15,6" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ZAKŁADKA 3: KONFERENCJE -->
                <TabItem Header="Konferencje">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Harmonogram nadchodzących konferencji naukowych" FontSize="16" Foreground="#88888D" Margin="0,0,0,15"/>
                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
Height="38" Margin="0,0,15,0" 
Background="#1E1E20" Foreground="#EEEEEE" BorderBrush="#333337" BorderThickness="1" 
VerticalContentAlignment="Center" Padding="12,0,0,0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding ConferencesView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E20" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Margin="0,0,15,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="160" Height="120" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Nazwa}" FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE" TextWrapping="Wrap" VerticalAlignment="Center"/>

                                                        <Button Grid.Column="1" Command="{Binding DataContext.FavoriteConferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding ID}"
        BorderThickness="1" Padding="12,6" Cursor="Hand" VerticalAlignment="Top" Margin="10,0,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Content" Value="☆ Dodaj do ulubionych"/>
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Foreground" Value="#E2C044"/>
                                                                    <Setter Property="BorderBrush" Value="#E2C044"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CzyUlubione}" Value="True">
                                                                            <Setter Property="Content" Value="★ W ulubionych"/>
                                                                            <Setter Property="Background" Value="#E2C044"/>
                                                                            <Setter Property="Foreground" Value="#1E1E20"/>
                                                                            <Setter Property="BorderBrush" Value="#E2C044"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">

                                                        <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📅 " Foreground="#81C784" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Data, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#DDDDDD" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📍 " Foreground="#64B5F6" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Miejsce}" Foreground="#DDDDDD" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal">

                                                        <Button Content="✎ Edytuj" 
                                                Command="{Binding DataContext.EditConferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" 
                                                Visibility="{Binding DataContext.AdminVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#2D2D30" Foreground="#DDDDDD" BorderThickness="0" Padding="15,6" Margin="0,0,10,0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="🗑 Usuń" 
                                                Command="{Binding DataContext.DeleteConferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding ID}"
                                                Visibility="{Binding DataContext.IsAdmin, Converter={StaticResource BoolToVisConverter}, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#3A2020" Foreground="#FF6B6B" BorderThickness="0" Padding="15,6" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ZAKŁADKA 4: ULUBIONE -->
                <TabItem Header="Ulubione">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Margin="0,15,0,0">
                        <StackPanel Margin="0,0,15,20">

                            <TextBlock Text="Moje zapisane materiały" FontSize="22" FontWeight="SemiBold" Foreground="#EEEEEE" Margin="0,0,0,25"/>

                            <TextBlock Text="Ulubione Publikacje" FontSize="16" Foreground="#88888D" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding FavoritePublications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E20" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Margin="0,0,0,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="120" Height="140" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Tytul}" FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Wydawnictwo, StringFormat='Wydawnictwo: {0}'}" Foreground="#9E9E9E" FontSize="14" Margin="0,6,0,12"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding RokWydania, StringFormat='Rok: {0}'}" Foreground="#DDDDDD" FontSize="12"/>
                                                        </Border>
                                                        <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                            <TextBlock Text="{Binding Typ}" Foreground="#64B5F6" FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding PlikPdf, StringFormat='📄 {0}'}" Foreground="#64B5F6" Margin="0,0,0,15" Cursor="Hand" FontSize="13"/>

                                                    <Button Content="💔 Usuń z ulubionych" 
                                            Command="{Binding DataContext.FavoritePublicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding ID}" 
                                            HorizontalAlignment="Left" Padding="12,6" Background="#3A2020" Foreground="#FF6B6B" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Ulubione Projekty" FontSize="16" Foreground="#88888D" Margin="0,20,0,10"/>
                            <ItemsControl ItemsSource="{Binding FavoriteProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E20" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Margin="0,0,0,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="140" Height="140" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Tytul}" FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Opis}" Foreground="#9E9E9E" FontSize="14" Margin="0,8,0,12" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="📅" FontSize="12" Foreground="#666" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DataRozpoczecia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#81C784" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" ➔ " Foreground="#555" FontSize="13" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBlock Text="{Binding DataZakonczenia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#E57373" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Button Content="💔 Usuń z ulubionych" 
                                            Command="{Binding DataContext.FavoriteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding ID}" 
                                            HorizontalAlignment="Left" Padding="12,6" Background="#3A2020" Foreground="#FF6B6B" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Ulubione Konferencje" FontSize="16" Foreground="#88888D" Margin="0,20,0,10"/>
                            <ItemsControl ItemsSource="{Binding FavoriteConferences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E20" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Margin="0,0,0,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="160" Height="120" CornerRadius="8" Margin="0,0,20,0" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding SciezkaZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nazwa}" FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📅 " Foreground="#81C784" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Data, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#DDDDDD" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📍 " Foreground="#64B5F6" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Miejsce}" Foreground="#DDDDDD" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <Button Content="💔 Usuń z ulubionych" 
                                            Command="{Binding DataContext.FavoriteConferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding ID}" 
                                            HorizontalAlignment="Left" Padding="12,6" Background="#3A2020" Foreground="#FF6B6B" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- ZAKŁADKA 5: MOJE PROJEKTY -->

                <TabItem Header="Moje projekty" Visibility="{Binding IsStudent, Converter={StaticResource BoolToVisConverter}}">
                    <Grid Margin="0,15,0,0">
                        <TextBlock Text="Projekty, do których należysz" FontSize="20" FontWeight="SemiBold" Foreground="#EEEEEE" Margin="0,0,0,20" VerticalAlignment="Top"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,40,0,0">
                            <ItemsControl ItemsSource="{Binding MyProjectsList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E20" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Margin="0,0,15,15" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="100" Height="100" CornerRadius="8" Margin="0,0,20,0">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding NazwaPlikuZdjecia}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Tytul}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <TextBlock Text="📅" FontSize="12" Foreground="#666" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DataRozpoczecia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#81C784" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" ➔ " Foreground="#555" FontSize="13" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBlock Text="{Binding DataZakonczenia, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#E57373" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">

                                                    <Border Background="#1B5E20" CornerRadius="6" Padding="12,6" Margin="0,0,0,8">
                                                        <TextBlock Text="✔️ Uczestnik" Foreground="#E0F2F1" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                                    </Border>

                                                    <Button Content="❌ Zrezygnuj" 
            Command="{Binding DataContext.LeaveProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
            CommandParameter="{Binding ID}"
            Background="#C62828" 
            Foreground="White" 
            FontWeight="SemiBold"
            BorderThickness="0" 
            Padding="12,6" 
            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#B71C1C"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>

                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>