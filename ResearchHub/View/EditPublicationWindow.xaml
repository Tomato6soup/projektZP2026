<Window x:Class="ResearchHub.View.EditPublicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edytuj Publikację" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tytuł:" Foreground="White" Margin="0,5"/>
        <TextBox x:Name="txtTytul" Grid.Row="1" Margin="0,0,0,15" Padding="5"/>

        <TextBlock Text="Rok wydania:" Grid.Row="2" Foreground="White" Margin="0,5"/>
        <TextBox x:Name="txtRok" Grid.Row="3" Margin="0,0,0,15" Padding="5"/>

        <TextBlock Text="Wydawnictwo:" Grid.Row="4" Foreground="White" Margin="0,5"/>
        <TextBox x:Name="txtWydawnictwo" Grid.Row="5" Margin="0,0,0,15" Padding="5"/>
        <TextBlock Text="Typ:" Foreground="White" Margin="0,5"/>
        <TextBox x:Name="txtTyp" Margin="0,0,0,15" Padding="5"/>

        <TextBlock Text="Plik PDF:" Foreground="White" Margin="0,5"/>
        <TextBox x:Name="txtPlik" Margin="0,0,0,15" Padding="5"/>

        <TextBlock Text="Ilość stron:" Foreground="White" Margin="0,5"/>
        <TextBox x:Name="txtStrony" Margin="0,0,0,15" Padding="5"/>
        <TextBlock Text="Zdjęcie:" Foreground="White" Margin="0,5"/>
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="📁 Wybierz..." Grid.Column="0" Padding="10,5" Margin="0,0,10,0"
            Background="#333337" Foreground="White" BorderThickness="1" BorderBrush="#555" 
            Click="btnWybierzZdjecie_Click"/>

            <TextBox x:Name="txtZdjecie" Grid.Column="1" Padding="5" 
             IsReadOnly="True" Foreground="Gray" Background="#2D2D30" BorderThickness="0"/>
        </Grid>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Anuluj" Width="80" Padding="5" Margin="0,0,10,0" Click="btnAnuluj_Click"/>
            <Button Content="Zapisz" Width="80" Padding="5" Background="#0078D7" Foreground="White" Click="btnZapisz_Click"/>
        </StackPanel>
    </Grid>
</Window>