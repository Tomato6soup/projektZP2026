<Window x:Class="ResearchHub.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ResearchHub.ViewModel"
        Title="ResearchHub - Logowanie" Height="450" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#18181A" Foreground="White">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <!-- Border obsługuje właściwość Padding bezbłędnie -->
    <Border Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logotyp i Tytuł -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,25">
                <TextBlock Text="ResearchHub" FontSize="26" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Center"/>
                <TextBlock Text="Zarządzanie Publikacjami i Projektami" FontSize="11" Foreground="#888888" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Pola logowania -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Login" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Username, Mode=TwoWay}" Height="35" Background="#2D2D30" Foreground="White" Margin="0,0,0,15"/>

                <TextBlock Text="Hasło" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                <PasswordBox Name="TxtPassword" PasswordChanged="PasswordBox_PasswordChanged" Height="35" Background="#2D2D30" Foreground="White" Margin="0,0,0,20"/>

                <Button Command="{Binding LoginCommand}" Content="Zaloguj" Height="40" Background="#0078D4" Foreground="White" BorderThickness="0" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Status logowania -->
            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#FF5E5E" FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </Grid>
    </Border>
</Window>
